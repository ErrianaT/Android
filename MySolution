import java.util.Scanner;

public class SearchSimulation {
    private static String currentSearch = "";
    private static String finalSearch = "";

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Simulating the search menu
        while (true) {
            System.out.println("Enter search query (or 'exit' to quit): ");
            String input = scanner.nextLine();

            if (input.equalsIgnoreCase("exit")) {
                break;
            }

            if (input.isEmpty()) {
                if (!finalSearch.isEmpty()) {
                    // Simulating restoring the last search when the user closes a card's window
                    currentSearch = finalSearch;
                    System.out.println("Restoring last search: " + currentSearch);
                } else {
                    System.out.println("Showing all results.");
                }
            } else {
                // Updating the current search query
                currentSearch = input;
                System.out.println("Searching for: " + currentSearch);
                // Saving current query as final when the search changes
                finalSearch = currentSearch;
            }

            // Simulating resetting the whole searching process
            if (input.equalsIgnoreCase("reset")) {
                currentSearch = "";
                finalSearch = "";
                System.out.println("Search reset.");
            }
        }

        scanner.close();
    }
}
